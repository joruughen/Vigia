flowchart TD
    IN["POST /api/mediciones<br/>JSON del sensor"] --> FMT{"Formato<br/>válido?"}
    FMT -->|"No"| E422["HTTP 422<br/>no se guarda nada"]
    FMT -->|"Sí"| TX["BEGIN IMMEDIATE<br/>descifra K si el sensor está activo<br/>lee el último registro"]
    TX -.->|"blob de K alterado"| E500["ROLLBACK<br/>HTTP 500 genérico"]
    TX --> P1{"1. Sensor<br/>registrado<br/>y activo?"}
    P1 -->|"No"| FALSA["FALSA"]
    P1 -->|"Sí"| P2{"2. HMAC<br/>válido?"}
    P2 -->|"No"| MANIP["MANIPULADA"]
    P2 -->|"Sí"| P3{"3. seq =<br/>última + 1?"}
    P3 -->|"No"| REPLAY["REPLAY O HUECO"]
    P3 -->|"Sí"| P4{"4. Dentro<br/>de la ventana?"}
    P4 -->|"No"| VENT["FUERA DE<br/>VENTANA"]
    P4 -->|"Sí"| P5{"5. Último registro<br/>consistente?<br/>hash y HMAC"}
    P5 -->|"No"| ROTA["CADENA ROTA"]
    P5 -->|"Sí"| HASH["h_i = SHA256<br/>h_prev ‖ mensaje ‖ tag"]
    HASH --> OK["VERIFICADA"]
    OK --> INSM["INSERT en mediciones"]
    INSM --> EVT
    FALSA & MANIP & REPLAY & VENT & ROTA --> EVT
    EVT["INSERT en eventos<br/>tag si VERIFICADA<br/>huella si rechazada"] --> COM["COMMIT<br/>HTTP 200 con estado"]

    classDef bueno fill:#d4edda,stroke:#2e7d32,color:#000
    classDef malo fill:#f8d7da,stroke:#c62828,color:#000
    classDef aviso fill:#fff3cd,stroke:#b58900,color:#000
    class OK bueno
    class FALSA,MANIP,REPLAY,VENT,ROTA malo
    class E422,E500 aviso
