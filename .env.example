# Copiar a .env y cambiar los valores. .env NUNCA se sube al repo.
# Contraseña maestra: de ella se deriva (Argon2id) la llave AES-256-GCM que cifra las llaves de los sensores.
# Mínimo 16 caracteres; se rechaza el valor de ejemplo de abajo. Genera una buena con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VIGIA_MASTER_PASSWORD=cambia-esta-contrasena-larga-y-aleatoria
# Ruta de la base de datos SQLite
VIGIA_DB_PATH=data/vigia.db
# Ventana de frescura del timestamp (milisegundos)
VIGIA_VENTANA_MS=30000
# Carpeta donde se escriben las llaves de sensores (simula la entrega fuera de banda; gitignored)
VIGIA_SENSORES_DIR=sensores
# Carpeta de certificado/llave TLS de desarrollo (scripts/generar_cert.sh y scripts/run_server.py)
VIGIA_CERTS_DIR=certs
# Opcionales del servidor (por defecto 127.0.0.1:8443)
# VIGIA_HOST=127.0.0.1
# VIGIA_PORT=8443
